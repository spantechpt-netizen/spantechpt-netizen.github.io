# ---- Span Tech CRM configuration ----
# Copy to .env and edit before running in production.

# Port the CRM listens on
PORT=8090

# Bind address (0.0.0.0 exposes to the network, 127.0.0.1 is local only)
HOST=0.0.0.0

# Absolute or relative path to the SQLite database file
DB_PATH=./data/spantech.db

# Secret used to sign session cookies. MUST be changed in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-please-generate-a-long-random-string

# Session lifetime in hours
SESSION_HOURS=72

# Set to "true" only when the CRM is served over HTTPS (recommended)
SECURE_COOKIES=false

# First administrator created on an empty database
ADMIN_EMAIL=admin@spantechksa.com
ADMIN_PASSWORD=SpanTech@2026
ADMIN_NAME=System Administrator
